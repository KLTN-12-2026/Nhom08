MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# RevenueCat API Keys
# Get from: https://app.revenuecat.com → Settings → API Keys
REVENUECAT_IOS_API_KEY=your_ios_api_key_here
REVENUECAT_ANDROID_API_KEY=your_android_api_key_here

# Cloudinary Configuration
# Get these values from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
